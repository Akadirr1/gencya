# Bu proje npm ile çalışır (tek lockfile: package-lock.json).
# Başka bir paket yöneticisiyle lokalde denenirse üreteceği lockfile repoya
# girmesin — iki lockfile bir arada Turbopack'in workspace kökünü yanlış
# çözmesine ve kurulumların ayrışmasına yol açıyor.
.pnpm-store/
pnpm-lock.yaml
yarn.lock

# Claude Code kişisel ayarları — yerel kalır
.claude/settings.local.json

# Ham fotoğraf kaynakları — işlenmiş hâlleri frontend/public/profile/ altında
görseller yeni/

# Veritabanı yedekleri — başvuranların kişisel verilerini içerir, asla commit edilmez
backend/backups/
